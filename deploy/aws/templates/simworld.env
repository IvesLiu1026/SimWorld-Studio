# /etc/default/simworld
#
# Override any of the systemd unit's environment defaults here. systemd reloads
# this file on every service restart, no daemon-reload needed.

# Number of UE slots (concurrent UE instances).
# Default 3, sized for g5.4xlarge (1× A10G, 64 GB RAM).
# Increase only if you have enough VRAM (~4 GB/slot) AND RAM (~8 GB/slot).
# UE_POOL_SIZE=3

# Number of physical GPUs to spread slots across.
# = 1 for g5.xlarge/2xlarge/4xlarge (single A10G)
# = 4 for g5.12xlarge (four A10Gs, 1:1 mapping)
# UE_GPU_COUNT=1

# Pool of waiting users when all slots are full.
# UE_MAX_QUEUE=10

# How long a session can stay idle before it's reaped. Default 30 min.
# SESSION_TTL_MS=1800000

# Hard cap on a single session's lifetime. Default 3 h. Lower this if you want
# to enforce sharing on a busy day.
# SESSION_HARD_MAX_MS=10800000

# How long the slot-launcher waits for UE to come up before declaring failure.
# UE_STARTUP_TIMEOUT_MS=180000

# Every production UE slot reserves its exact MCP/Cirrus/UCV endpoint family
# before spawn. Keep the registry on the same persistent, service-owned volume.
# PROCESS_PORT_REGISTRY_DIR=/var/lib/simworld/runtime-registry
# PROCESS_PORT_REGISTRY_REQUIRED=1
# PROCESS_PORT_REGISTRY_HEARTBEAT_MS=10000

# Per-user daily Claude API budget (USD). Reads result.total_cost_usd from
# Claude CLI's --output json and refuses new requests after the cap.
# Not yet implemented in core; placeholder for follow-up.
# CLAUDE_DAILY_BUDGET_USD=20

# Production builder model. Keep this aligned with the reviewed Studio release;
# change it only as an explicit deployment decision.
CLAUDE_MODEL=claude-opus-4-8

# ── Required for public WebRTC ──────────────────────────────────────────────
# Keep Node and every Cirrus listener on loopback. nginx is the only public
# HTTP/WSS entry point, and Node accepts forwarded authority only from the
# listed numeric loopback proxy address.
# STUDIO_TRANSPORT_PROFILE=trusted_proxy
# STUDIO_PUBLIC_ORIGIN=https://studio.your-lab.edu
# STUDIO_TRUSTED_PROXY=127.0.0.1,::1

# Root-owned files, mode 0600, readable by the simworld service account (or by
# a dedicated secret-delivery group). Use independent random values >=32 bytes.
# STUDIO_ACCESS_TOKEN_FILE=/etc/simworld/secrets/studio_access_token
# STUDIO_PIXEL_STREAMING_HMAC_KEY_FILE=/etc/simworld/secrets/pixel_streaming_hmac
# TURN_SHARED_SECRET_FILE=/etc/simworld/secrets/turn_shared_secret
# Numeric GID that is explicitly allowed to read a 0640 TURN secret. Omit only
# when TURN_SHARED_SECRET_FILE is 0400/0600.
# TURN_SHARED_SECRET_FILE_GID=1234
# Container runtime identity must exactly match the host owner of
# /var/lib/simworld; do not assume the image-local account has the same IDs.
# SIMWORLD_RUNTIME_UID=1234
# SIMWORLD_RUNTIME_GID=1234
# SIMWORLD_SECRET_GID=1234
# Numeric `turnserver` GID for atomic root:turnserver 0640 config publication.
# TURN_CONFIG_GID=1235

# TURN_PUBLIC_HOST=turn.your-lab.edu
# TURN_CREDENTIAL_TTL_SECONDS=14400
# TURN_CREDENTIAL_RECONNECT_GRACE_SECONDS=600
# TURN_TRANSPORT_POLICY=relay

# Pin readiness receipts and deployment evidence to the exact git commit.
# SIMWORLD_BUILD_REVISION=<40-character-git-revision>
# SIMWORLD_WEB_IMAGE=simworld/web@sha256:<immutable-image-digest>
# WEBRTC_READINESS_RECEIPT_FILE_HOST=/var/lib/simworld/evidence/webrtc-readiness.json
# WEBRTC_READINESS_RECEIPT_SHA256=<sha256-of-exact-receipt-bytes>
# WEBRTC_DEPLOYMENT_FINGERPRINT=<reviewed-deployment-manifest-sha256>
# WEBRTC_CERTIFICATE_SHA256=<public-certificate-sha256>

# ── Required Text + Visual Review evidence ─────────────────────────────────
# These are separate tool-free Claude Opus 4.8 PASS receipts. The Visual
# receipt must preserve the exact pre/post scene digest.
# CRITIC_MAX_BUDGET_USD=0.05
# REVIEW_TEXT_SMOKE_RECEIPT_FILE_HOST=/var/lib/simworld/evidence/review-smoke-text.json
# REVIEW_TEXT_SMOKE_RECEIPT_SHA256=<sha256-of-exact-text-receipt-bytes>
# REVIEW_VISUAL_SMOKE_RECEIPT_FILE_HOST=/var/lib/simworld/evidence/review-smoke-visual.json
# REVIEW_VISUAL_SMOKE_RECEIPT_SHA256=<sha256-of-exact-visual-receipt-bytes>

# ── Required immutable semantic asset snapshot ─────────────────────────────
# Every image must be an reviewed immutable `name@sha256:<digest>` reference.
# Build `tools/Dockerfile.embedding` separately with pinned Python/uv bases,
# publish it, then use the resulting content digest here.
# ASSET_STACK_PROFILE=aws
# POSTGRES_IMAGE=postgres@sha256:<digest>
# QDRANT_IMAGE=qdrant/qdrant@sha256:<digest>
# EMBED_SERVICE_IMAGE=registry.example/simworld/asset-embedding@sha256:<digest>
# ASSET_TOOLS_PYTHON_IMAGE=python@sha256:<digest>
# ASSET_TOOLS_UV_IMAGE=ghcr.io/astral-sh/uv@sha256:<digest>
# POSTGRES_DB=asset_db
# POSTGRES_USER=simworld
# POSTGRES_HOST_PORT=55432
# POSTGRES_PASSWORD_FILE_HOST=/etc/simworld/secrets/postgres_password
# POSTGRES_DATA_DIR_HOST=/var/lib/simworld/postgres
# QDRANT_DATA_DIR_HOST=/var/lib/simworld/qdrant
# EMBEDDING_MODEL_CACHE_DIR_HOST=/var/lib/simworld/fastembed
# EMBED_DENSE_MODEL_DIR_HOST=/opt/simworld-models/dense/<artifact-revision>
# EMBED_SPARSE_MODEL_DIR_HOST=/opt/simworld-models/sparse/<artifact-revision>
# ASSET_DB_DIR_HOST=/var/lib/simworld/asset-db
# ASSET_SNAPSHOT_REVISION=asset-snapshot-<immutable-revision>
# ASSET_LIVE_AUDIT_RECEIPT_SHA256=<sha256-of-current-short-lived-receipt-bytes>
# VISTA_UE_CONTENT_REVISION=<matching-immutable-ue-content-revision>
# POSTGRES_URL_FILE_HOST=/etc/simworld/secrets/postgres_url
# QDRANT_API_KEY_FILE_HOST=/etc/simworld/secrets/qdrant_api_key
# EMBED_SERVICE_TOKEN_FILE_HOST=/etc/simworld/secrets/embed_service_token
# The pinned Qdrant image must be configured to enforce the same API key via
# an administrator-reviewed image-specific config. Record denied unauthorized
# and successful authorized probes; never interpolate the key into Compose.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=<snapshot-collection>
# EMBED_SERVICE_URL=http://127.0.0.1:7777
# EMBED_VERSION=<snapshot-embedding-version>
# EMBED_DENSE_MODEL=BAAI/bge-large-en-v1.5
# EMBED_DENSE_REVISION=sha256:<artifact-manifest-digest>
# EMBED_DENSE_SIZE=1024
# EMBED_SPARSE_MODEL=Qdrant/bm25
# EMBED_SPARSE_REVISION=sha256:<artifact-manifest-digest>
# ASSET_BACKUP_ROOT=/var/backups/simworld/asset-stack
# ASSET_BACKUP_RETENTION_DAYS=30
# ASSET_BACKUP_MIN_FREE_BYTES=107374182400

# ── Required VISTA import, scene build, and animation receipts ─────────────
# The dataset bundle and layout/profile files must be immutable, regular,
# administrator-reviewed files. Their host paths are mounted read-only; run
# records are written beneath the existing /var/lib/simworld persistent mount.
# VISTA_IMPORT_DATASET_REVISION=<immutable-vista-dataset-revision>
# VISTA_IMPORT_BUNDLE_ROOT_HOST=/var/lib/simworld/vista-input/<revision>
# VISTA_IMPORT_MANIFEST=manifest.json
# VISTA_SCENE_LAYOUT_PROFILE_ID=<verified-layout-profile-id>
# VISTA_SCENE_LAYOUT_PROFILE_FILE_HOST=/etc/simworld/config/vista-scene-layout.json
# VISTA_SCENE_LAYOUT_PROFILE_SHA256=<sha256-of-exact-layout-profile-bytes>
# VISTA_ASSET_VERIFICATION_REVISION=<exact-scene-spawn-verification-revision>
# VISTA_UE_CONTENT_RECEIPT_SHA256=<sha256-of-verified-ue-content-receipt>
# VISTA_ANIMATION_CONTENT_PROFILE_FILE_HOST=/etc/simworld/config/vista-animation-content-profile.json
# VISTA_ANIMATION_CONTENT_PROFILE_SHA256=<sha256-of-exact-content-profile-bytes>
# VISTA_ANIMATION_UE_PLUGIN_ARTIFACT_FILE_HOST=/etc/simworld/config/vista-animation-plugin-artifact.json
# VISTA_ANIMATION_UE_PLUGIN_ARTIFACT_SHA256=<sha256-of-exact-plugin-artifact-manifest-bytes>
