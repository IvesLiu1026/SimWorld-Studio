{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simworld.org/schemas/vista-animation-preflight-v1.schema.json",
  "title": "VISTA animation capability preflight",
  "description": "Mutation-free proof of the exact content, actor, target, IK anchor, action implementation, and completion-signal capabilities observed by the shared UE broker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "preflight_id",
    "scene_revision",
    "profile_id",
    "profile_revision",
    "content_revision",
    "content_digest",
    "registry_revision",
    "start_allowed",
    "requested_actions",
    "supported_actions",
    "actors",
    "targets",
    "actions",
    "issues"
  ],
  "properties": {
    "schema": { "const": "vista-animation-preflight/v1" },
    "preflight_id": { "type": "string", "pattern": "^vap-[a-f0-9]{24}$" },
    "scene_revision": { "$ref": "#/$defs/opaqueId" },
    "profile_id": { "$ref": "#/$defs/safeId" },
    "profile_revision": { "$ref": "#/$defs/safeId" },
    "content_revision": { "$ref": "#/$defs/opaqueId" },
    "content_digest": { "$ref": "#/$defs/sha256" },
    "registry_revision": { "$ref": "#/$defs/safeId" },
    "start_allowed": { "type": "boolean" },
    "requested_actions": { "$ref": "#/$defs/actionList" },
    "supported_actions": { "$ref": "#/$defs/actionList" },
    "actors": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/runtimeBinding" }
    },
    "targets": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/runtimeBinding" }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/actionStatus" }
    },
    "issues": {
      "type": "array",
      "maxItems": 1263,
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,119}$" },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actionName": {
      "enum": ["look_at", "pick_up", "brace", "drag", "lift_foot", "pause", "fall", "recover"]
    },
    "actionList": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/actionName" }
    },
    "capabilityList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "available",
        "class_matches",
        "skeleton_matches",
        "capabilities",
        "anchor_kinds",
        "declared_capabilities",
        "ready"
      ],
      "properties": {
        "binding_id": { "$ref": "#/$defs/safeId" },
        "available": { "type": "boolean" },
        "class_matches": { "type": "boolean" },
        "skeleton_matches": { "type": "boolean" },
        "capabilities": { "$ref": "#/$defs/capabilityList" },
        "anchor_kinds": { "$ref": "#/$defs/capabilityList" },
        "declared_capabilities": { "$ref": "#/$defs/capabilityList" },
        "ready": { "type": "boolean" }
      }
    },
    "actionStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "bridge_action_id",
        "available",
        "implementation_matches",
        "completion_signal_available",
        "adapter_id",
        "version",
        "timeout_ms",
        "implementation_asset",
        "completion_signal",
        "ready"
      ],
      "properties": {
        "action": { "$ref": "#/$defs/actionName" },
        "bridge_action_id": { "$ref": "#/$defs/safeId" },
        "available": { "type": "boolean" },
        "implementation_matches": { "type": "boolean" },
        "completion_signal_available": { "type": "boolean" },
        "adapter_id": { "$ref": "#/$defs/safeId" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "timeout_ms": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 100, "maximum": 60000 }
          ]
        },
        "implementation_asset": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^/Game/[A-Za-z0-9_./-]{1,500}$" }
          ]
        },
        "completion_signal": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/safeId" }
          ]
        },
        "ready": { "type": "boolean" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "code", "subject", "message"],
      "properties": {
        "issue_id": { "type": "string", "pattern": "^vai-[a-f0-9]{16}$" },
        "code": {
          "enum": [
            "ACTOR_CAPABILITY_UNVERIFIED",
            "TARGET_CAPABILITY_UNVERIFIED",
            "ACTION_CONTENT_UNVERIFIED",
            "ACTION_IMPLEMENTATION_UNAVAILABLE",
            "ACTION_COMPLETION_SIGNAL_UNAVAILABLE"
          ]
        },
        "subject": { "type": "string", "minLength": 1, "maxLength": 160 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
