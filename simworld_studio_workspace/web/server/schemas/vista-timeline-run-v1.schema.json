{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simworld.org/schemas/vista-timeline-run-v1.schema.json",
  "title": "VISTA timeline run artifact",
  "description": "The server-authoritative execution evidence contract. This schema does not implement or authorize a scheduler or UE mutation path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "timeline_id",
    "scene_revision",
    "correlation_id",
    "owner_id",
    "session_id",
    "slot_id",
    "duration_sec",
    "clock",
    "state",
    "created_at",
    "started_at",
    "ended_at",
    "events",
    "checkpoints",
    "cleanup"
  ],
  "properties": {
    "schema": { "const": "vista-timeline-run/v1" },
    "run_id": { "type": "string", "pattern": "^vtr-[a-z0-9_-]{8,120}$" },
    "timeline_id": { "type": "string", "pattern": "^vtl-[a-f0-9]{24}$" },
    "scene_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlation_id": { "$ref": "#/$defs/opaqueId" },
    "owner_id": { "$ref": "#/$defs/opaqueId" },
    "session_id": { "$ref": "#/$defs/opaqueId" },
    "slot_id": { "$ref": "#/$defs/opaqueId" },
    "duration_sec": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
    "clock": { "const": "server_monotonic" },
    "state": {
      "enum": [
        "queued",
        "preflighting",
        "ready",
        "running",
        "pausing",
        "paused",
        "stopping",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "created_at": { "$ref": "#/$defs/dateTime" },
    "started_at": { "$ref": "#/$defs/nullableDateTime" },
    "ended_at": { "$ref": "#/$defs/nullableDateTime" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/runEvent" }
    },
    "checkpoints": {
      "type": "array",
      "maxItems": 1001,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "cleanup": { "$ref": "#/$defs/cleanup" }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]*$"
    },
    "dateTime": { "type": "string", "format": "date-time" },
    "nullableDateTime": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/dateTime" }
      ]
    },
    "nullableNumber": {
      "oneOf": [
        { "type": "null" },
        { "type": "number" }
      ]
    },
    "nullableText": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 4000 }
      ]
    },
    "runEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "adapter_id",
        "planned_sec",
        "actual_sec",
        "engine_time",
        "drift_ms",
        "state",
        "attempt",
        "started_at",
        "ended_at",
        "result",
        "error",
        "cleanup_state"
      ],
      "properties": {
        "event_id": { "type": "string", "pattern": "^beat-[0-9]{4}(?:-[a-z0-9_-]+)?$" },
        "adapter_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,119}$" }
          ]
        },
        "planned_sec": { "type": "number", "minimum": 0, "maximum": 3600 },
        "actual_sec": { "$ref": "#/$defs/nullableNumber" },
        "engine_time": { "$ref": "#/$defs/nullableNumber" },
        "drift_ms": { "$ref": "#/$defs/nullableNumber" },
        "state": {
          "enum": [
            "pending",
            "dispatched",
            "running",
            "completed",
            "skipped",
            "failed",
            "cancelled",
            "timed_out"
          ]
        },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 100 },
        "started_at": { "$ref": "#/$defs/nullableDateTime" },
        "ended_at": { "$ref": "#/$defs/nullableDateTime" },
        "result": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "maxProperties": 128 }
          ]
        },
        "error": { "$ref": "#/$defs/nullableText" },
        "cleanup_state": {
          "enum": ["not_required", "pending", "completed", "failed"]
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_sec", "engine_time", "state", "evidence_ids", "validator"],
      "properties": {
        "at_sec": { "type": "number", "minimum": 0, "maximum": 3600 },
        "engine_time": { "$ref": "#/$defs/nullableNumber" },
        "state": { "type": "string", "minLength": 1, "maxLength": 120 },
        "evidence_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueId" }
        },
        "validator": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "maxProperties": 64 }
          ]
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "pending_items", "confirmed_stopped", "ended_pie", "error"],
      "properties": {
        "state": { "enum": ["not_required", "pending", "completed", "partial", "failed"] },
        "pending_items": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "confirmed_stopped": { "type": "boolean" },
        "ended_pie": { "type": "boolean" },
        "error": { "$ref": "#/$defs/nullableText" }
      }
    }
  }
}
