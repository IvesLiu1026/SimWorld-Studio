{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vista-world.invalid/schemas/daily-maintainer/backlog.v1.json",
  "title": "VISTA World Daily Maintainer Reviewed Backlog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_revision",
    "approved_by",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "vista.world.daily-maintainer.backlog.v1"
    },
    "manifest_revision": {
      "type": "integer",
      "minimum": 1
    },
    "approved_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "candidate.schema.json"
      }
    }
  }
}
