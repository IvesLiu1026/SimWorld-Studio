    "setting":           {"type": "string", "enum": ["modern_urban","industrial","suburban_residential","commercial_retail","nature_rural","coastal_harbor","medieval","fantasy_gothic","ancient_temple","middle_eastern","east_asian","winter","sci_fi","indoor","generic"], "description": "Primary thematic setting/genre this asset reads as; use 'generic' for plain cross-setting props that fit many genres."}
