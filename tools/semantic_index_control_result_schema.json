{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simworld.org/schemas/simworld-semantic-index-control-result-v1.schema.json",
  "title": "SimWorld semantic index fixed control result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol",
    "request_binding",
    "status",
    "mutation_state",
    "receipt",
    "error"
  ],
  "properties": {
    "schema": { "const": "simworld-semantic-index-control-result/v1" },
    "protocol": { "const": "simworld-semantic-index-worker/v1" },
    "request_binding": { "$ref": "#/$defs/requestBinding" },
    "status": { "enum": ["succeeded", "failed"] },
    "mutation_state": { "enum": ["none", "committed", "ambiguous"] },
    "receipt": {
      "oneOf": [{ "$ref": "#/$defs/controlReceipt" }, { "type": "null" }]
    },
    "error": {
      "oneOf": [{ "$ref": "#/$defs/remoteError" }, { "type": "null" }]
    }
  },
  "allOf": [
    { "$ref": "#/$defs/statusContract" },
    { "$ref": "#/$defs/queryContract" },
    { "$ref": "#/$defs/recoverContract" },
    { "$ref": "#/$defs/cancelContract" },
    { "$ref": "#/$defs/quarantineContract" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha256Revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-]*$"
    },
    "generationId": {
      "type": "string",
      "minLength": 84,
      "maxLength": 84,
      "pattern": "^semantic-generation:[a-f0-9]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "minLength": 20,
      "maxLength": 35,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "requestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_sha256",
        "request_id",
        "operation",
        "target_phase",
        "phase_request_sha256",
        "phase_idempotency_key",
        "control_idempotency_key",
        "idempotency_ledger_identity",
        "idempotency_ledger_revision",
        "job_revision",
        "reviewed_job_sha256",
        "approval_basis_sha256",
        "execution_plan_sha256",
        "launcher_handoff_receipt_sha256",
        "generation_id",
        "generation_binding_sha256",
        "host_boot_id_sha256",
        "deadline_monotonic_ns"
      ],
      "properties": {
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "request_id": { "$ref": "#/$defs/safeId" },
        "operation": {
          "enum": [
            "query_phase_status",
            "recover_phase_receipt",
            "cancel_phase_work",
            "quarantine_generation"
          ]
        },
        "target_phase": {
          "enum": ["inspect", "render", "caption", "embed", "postgres", "qdrant", "reconcile"]
        },
        "phase_request_sha256": { "$ref": "#/$defs/sha256" },
        "phase_idempotency_key": { "$ref": "#/$defs/sha256Revision" },
        "control_idempotency_key": { "$ref": "#/$defs/sha256Revision" },
        "idempotency_ledger_identity": { "$ref": "#/$defs/safeId" },
        "idempotency_ledger_revision": { "$ref": "#/$defs/sha256Revision" },
        "job_revision": { "$ref": "#/$defs/sha256Revision" },
        "reviewed_job_sha256": { "$ref": "#/$defs/sha256" },
        "approval_basis_sha256": { "$ref": "#/$defs/sha256" },
        "execution_plan_sha256": { "$ref": "#/$defs/sha256" },
        "launcher_handoff_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "generation_id": { "$ref": "#/$defs/generationId" },
        "generation_binding_sha256": { "$ref": "#/$defs/sha256" },
        "host_boot_id_sha256": { "$ref": "#/$defs/sha256" },
        "deadline_monotonic_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "controlReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "generation_id",
        "target_phase",
        "phase_request_sha256",
        "phase_idempotency_key",
        "control_idempotency_key",
        "observed_phase_state",
        "immutable_phase_receipt_sha256",
        "cancelled",
        "quarantined",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "schema": { "const": "simworld-semantic-index-control-receipt/v1" },
        "operation": {
          "enum": [
            "query_phase_status",
            "recover_phase_receipt",
            "cancel_phase_work",
            "quarantine_generation"
          ]
        },
        "generation_id": { "$ref": "#/$defs/generationId" },
        "target_phase": {
          "enum": ["inspect", "render", "caption", "embed", "postgres", "qdrant", "reconcile"]
        },
        "phase_request_sha256": { "$ref": "#/$defs/sha256" },
        "phase_idempotency_key": { "$ref": "#/$defs/sha256Revision" },
        "control_idempotency_key": { "$ref": "#/$defs/sha256Revision" },
        "observed_phase_state": { "enum": ["none", "staged", "committed", "ambiguous"] },
        "immutable_phase_receipt_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "cancelled": { "type": "boolean" },
        "quarantined": { "type": "boolean" },
        "issued_at": { "$ref": "#/$defs/rfc3339" },
        "expires_at": { "$ref": "#/$defs/rfc3339" }
      }
    },
    "remoteError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency", "code", "retryable", "mutation_state"],
      "properties": {
        "dependency": { "enum": ["worker", "evidence_store"] },
        "code": { "$ref": "#/$defs/safeId" },
        "retryable": { "type": "boolean" },
        "mutation_state": { "enum": ["none", "committed", "ambiguous"] }
      },
      "allOf": [{ "$ref": "#/$defs/remoteErrorIdentity" }]
    },
    "remoteErrorIdentity": {
      "oneOf": [
        { "properties": { "dependency": { "const": "worker" }, "code": { "const": "WORKER_BUSY" } }, "required": ["dependency", "code"] },
        { "properties": { "dependency": { "const": "worker" }, "code": { "const": "WORKER_INTERNAL" } }, "required": ["dependency", "code"] },
        { "properties": { "dependency": { "const": "worker" }, "code": { "const": "WORKER_LEDGER_CONFLICT" } }, "required": ["dependency", "code"] },
        { "properties": { "dependency": { "const": "worker" }, "code": { "const": "WORKER_CANCELLED" } }, "required": ["dependency", "code"] },
        { "properties": { "dependency": { "const": "evidence_store" }, "code": { "const": "EVIDENCE_STORE_UNAVAILABLE" } }, "required": ["dependency", "code"] },
        { "properties": { "dependency": { "const": "evidence_store" }, "code": { "const": "EVIDENCE_PUBLICATION_FAILED" } }, "required": ["dependency", "code"] }
      ]
    },
    "statusContract": {
      "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
      "then": {
        "properties": {
          "receipt": { "$ref": "#/$defs/controlReceipt" },
          "error": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "receipt": { "type": "null" },
          "error": { "$ref": "#/$defs/remoteError" }
        },
        "allOf": [
          {
            "if": { "properties": { "mutation_state": { "const": "none" } }, "required": ["mutation_state"] },
            "then": {
              "properties": {
                "error": { "properties": { "mutation_state": { "const": "none" } } }
              }
            }
          },
          {
            "if": { "properties": { "mutation_state": { "const": "committed" } }, "required": ["mutation_state"] },
            "then": {
              "properties": {
                "error": {
                  "properties": {
                    "mutation_state": { "const": "committed" },
                    "retryable": { "const": false }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "mutation_state": { "const": "ambiguous" } }, "required": ["mutation_state"] },
            "then": {
              "properties": {
                "error": {
                  "properties": {
                    "mutation_state": { "const": "ambiguous" },
                    "retryable": { "const": false }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "queryContract": {
      "if": { "properties": { "request_binding": { "properties": { "operation": { "const": "query_phase_status" } }, "required": ["operation"] } }, "required": ["request_binding"] },
      "then": {
        "properties": { "mutation_state": { "const": "none" } },
        "allOf": [{ "$ref": "#/$defs/queryReceiptByStatus" }]
      }
    },
    "recoverContract": {
      "if": { "properties": { "request_binding": { "properties": { "operation": { "const": "recover_phase_receipt" } }, "required": ["operation"] } }, "required": ["request_binding"] },
      "then": {
        "properties": { "mutation_state": { "const": "none" } },
        "allOf": [{ "$ref": "#/$defs/recoverReceiptByStatus" }]
      }
    },
    "cancelContract": {
      "if": { "properties": { "request_binding": { "properties": { "operation": { "const": "cancel_phase_work" } }, "required": ["operation"] } }, "required": ["request_binding"] },
      "then": { "allOf": [{ "$ref": "#/$defs/cancelOutcome" }] }
    },
    "quarantineContract": {
      "if": { "properties": { "request_binding": { "properties": { "operation": { "const": "quarantine_generation" } }, "required": ["operation"] } }, "required": ["request_binding"] },
      "then": { "allOf": [{ "$ref": "#/$defs/quarantineOutcome" }] }
    },
    "queryReceiptByStatus": {
      "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
      "then": {
        "properties": {
          "receipt": {
            "properties": {
              "operation": { "const": "query_phase_status" },
              "cancelled": { "const": false },
              "quarantined": { "const": false }
            }
          }
        }
      }
    },
    "recoverReceiptByStatus": {
      "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
      "then": {
        "properties": {
          "receipt": {
            "properties": {
              "operation": { "const": "recover_phase_receipt" },
              "immutable_phase_receipt_sha256": { "$ref": "#/$defs/sha256" },
              "cancelled": { "const": false },
              "quarantined": { "const": false }
            }
          }
        }
      }
    },
    "cancelOutcome": {
      "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
      "then": {
        "properties": {
          "mutation_state": { "const": "committed" },
          "receipt": {
            "properties": {
              "operation": { "const": "cancel_phase_work" },
              "cancelled": { "const": true },
              "quarantined": { "const": false }
            }
          }
        }
      },
      "else": { "properties": { "mutation_state": { "enum": ["none", "committed", "ambiguous"] } } }
    },
    "quarantineOutcome": {
      "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
      "then": {
        "properties": {
          "mutation_state": { "const": "committed" },
          "receipt": {
            "properties": {
              "operation": { "const": "quarantine_generation" },
              "cancelled": { "const": false },
              "quarantined": { "const": true }
            }
          }
        }
      },
      "else": { "properties": { "mutation_state": { "enum": ["none", "committed", "ambiguous"] } } }
    }
  }
}
