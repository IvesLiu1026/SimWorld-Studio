{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simworld.org/schemas/simworld-semantic-index-caption-artifact-v1.schema.json",
  "title": "SimWorld semantic index caption artifact root",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "phase", "operation", "bindings", "root_recomputation", "chunks", "evidence", "semantic_validation", "serialization_contract"],
  "properties": {
    "schema": { "const": "simworld-semantic-index-caption-artifact/v1" },
    "phase": { "const": "caption" },
    "operation": { "const": "caption_exact_render_set" },
    "bindings": { "$ref": "#/$defs/bindings" },
    "root_recomputation": { "$ref": "#/$defs/rootRecomputation" },
    "chunks": { "$ref": "#/$defs/chunks" },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["render_artifact_root_sha256", "render_manifest_sha256", "provider", "prompt_sha256", "output_schema_sha256", "request_policy", "usage", "records", "records_sha256", "catalog_sha256"],
      "properties": {
        "render_artifact_root_sha256": { "$ref": "#/$defs/sha256" }, "render_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "provider": {
          "type": "object", "additionalProperties": false,
          "required": ["provider_identity", "project_identity", "model_snapshot", "whoami_sha256", "target_attestation_sha256", "runtime_image"],
          "properties": {
            "provider_identity": { "$ref": "#/$defs/safeId" }, "project_identity": { "$ref": "#/$defs/safeId" },
            "model_snapshot": { "$ref": "#/$defs/revision" }, "whoami_sha256": { "$ref": "#/$defs/sha256" },
            "target_attestation_sha256": { "$ref": "#/$defs/sha256" }, "runtime_image": { "type": "null" }
          }
        },
        "prompt_sha256": { "$ref": "#/$defs/sha256" }, "output_schema_sha256": { "$ref": "#/$defs/sha256" },
        "request_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["tools_enabled", "strict_json_schema", "provider_idempotency", "retry_accounting"],
          "properties": {
            "tools_enabled": { "const": false }, "strict_json_schema": { "const": true },
            "provider_idempotency": { "enum": ["provider_key_and_worker_ledger", "worker_ledger_only_ambiguous_on_lost_receipt"] },
            "retry_accounting": { "const": "every_provider_accepted_call_counts_toward_budget" }
          }
        },
        "usage": {
          "type": "object", "additionalProperties": false,
          "required": ["provider_calls", "input_tokens", "output_tokens", "currency", "minor_units", "rounding"],
          "properties": {
            "provider_calls": { "type": "integer", "minimum": 1, "maximum": 4096 }, "input_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
            "output_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "minor_units": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "rounding": { "const": "provider_invoice_half_up_minor_units_v1" }
          }
        },
        "records": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/captionRecord" } },
        "records_sha256": { "$ref": "#/$defs/sha256" }, "catalog_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "semantic_validation": { "$ref": "#/$defs/semanticValidation" },
    "serialization_contract": { "$ref": "#/$defs/serializationContract" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha256Revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "safeId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-]*$" },
    "revision": { "type": "string", "minLength": 3, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]+$" },
    "generationId": { "type": "string", "pattern": "^semantic-generation:[a-f0-9]{64}$" },
    "assetId": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[a-z0-9][a-z0-9_]*$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "job_revision", "reviewed_job_sha256", "execution_plan_sha256", "approval_basis_sha256", "generation_id", "request_sha256", "phase_evidence_schema_sha256"],
      "properties": {
        "run_id": { "type": "string", "pattern": "^semantic-index-run:[A-Za-z0-9][A-Za-z0-9._:@+\\-]*$", "maxLength": 160 },
        "job_revision": { "$ref": "#/$defs/sha256Revision" }, "reviewed_job_sha256": { "$ref": "#/$defs/sha256" },
        "execution_plan_sha256": { "$ref": "#/$defs/sha256" }, "approval_basis_sha256": { "$ref": "#/$defs/sha256" },
        "generation_id": { "$ref": "#/$defs/generationId" }, "request_sha256": { "$ref": "#/$defs/sha256" },
        "phase_evidence_schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "chunk": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "content_address", "canonical_sha256", "canonical_byte_count", "record_count", "records_sha256"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 4095 }, "content_address": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" }, "canonical_byte_count": { "type": "integer", "minimum": 2, "maximum": 16777216 },
        "record_count": { "type": "integer", "minimum": 1, "maximum": 4096 }, "records_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "chunks": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/chunk" } },
    "rootRecomputation": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "phase_evidence_sha256", "ordered_chunks_sha256", "chunk_count", "record_count", "payload_byte_count", "preimage_fields", "artifact_root_sha256"],
      "properties": {
        "algorithm": { "const": "sha256-jcs-nul-separated-semantic-phase-artifact-root-v1" }, "phase_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "ordered_chunks_sha256": { "$ref": "#/$defs/sha256" }, "chunk_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "record_count": { "type": "integer", "minimum": 1, "maximum": 4096 }, "payload_byte_count": { "type": "integer", "minimum": 2, "maximum": 68719476736 },
        "preimage_fields": { "type": "array", "prefixItems": [{"const":"schema"},{"const":"generation_id"},{"const":"request_sha256"},{"const":"phase_evidence_sha256"},{"const":"ordered_chunks_sha256"},{"const":"record_count"}], "items": false, "minItems": 6, "maxItems": 6 },
        "artifact_root_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "captionRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "asset_id", "ordered_render_ids_sha256", "provider_request_id", "provider_idempotency_id", "strict_parse", "label_en", "label_zh_tw", "description_en", "description_zh_tw", "normalized_text_sha256", "provider_output_sha256", "record_sha256"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 4095 }, "asset_id": { "$ref": "#/$defs/assetId" },
        "ordered_render_ids_sha256": { "$ref": "#/$defs/sha256" }, "provider_request_id": { "$ref": "#/$defs/safeId" }, "provider_idempotency_id": { "$ref": "#/$defs/safeId" },
        "strict_parse": { "const": true }, "label_en": { "$ref": "#/$defs/text" }, "label_zh_tw": { "$ref": "#/$defs/text" },
        "description_en": { "$ref": "#/$defs/text" }, "description_zh_tw": { "$ref": "#/$defs/text" },
        "normalized_text_sha256": { "$ref": "#/$defs/sha256" }, "provider_output_sha256": { "$ref": "#/$defs/sha256" }, "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "semanticValidation": {
      "type": "object", "additionalProperties": false,
      "required": ["chunk_order", "chunk_uniqueness", "record_order", "record_uniqueness", "provider_call_ids_unique", "budget_recomputed", "counts_and_digests_recomputed", "every_chunk_fetched"],
      "properties": {
        "chunk_order": { "const": "index_ascending_zero_based_without_gaps" }, "chunk_uniqueness": { "const": "executor_linear_unique_index_content_address_and_digest_v1" },
        "record_order": { "const": "ordinal_then_asset_id_ascending" }, "record_uniqueness": { "const": "executor_linear_unique_asset_id_v1" },
        "provider_call_ids_unique": { "const": "executor_linear_unique_request_and_idempotency_ids_v1" }, "budget_recomputed": { "const": true },
        "counts_and_digests_recomputed": { "const": true }, "every_chunk_fetched": { "const": true }
      }
    },
    "serializationContract": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "canonicalization", "duplicate_keys", "unicode_normalization", "numbers", "nonfinite_numbers", "bom", "trailing_newline"],
      "properties": {
        "encoding": { "const": "utf-8" }, "canonicalization": { "const": "rfc8785-jcs-v1" }, "duplicate_keys": { "const": "reject" },
        "unicode_normalization": { "const": "require_already_nfc" }, "numbers": { "const": "integers_only" }, "nonfinite_numbers": { "const": "reject" },
        "bom": { "const": false }, "trailing_newline": { "const": false }
      }
    }
  }
}
