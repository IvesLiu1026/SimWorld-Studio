{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simworld.org/schemas/simworld-semantic-index-render-artifact-v1.schema.json",
  "title": "SimWorld semantic index render artifact root",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "phase", "operation", "bindings", "root_recomputation", "chunks", "evidence", "semantic_validation", "serialization_contract"],
  "properties": {
    "schema": { "const": "simworld-semantic-index-render-artifact/v1" },
    "phase": { "const": "render" },
    "operation": { "const": "render_exact_views" },
    "bindings": { "$ref": "#/$defs/bindings" },
    "root_recomputation": { "$ref": "#/$defs/rootRecomputation" },
    "chunks": { "$ref": "#/$defs/chunks" },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["inspect_evidence_sha256", "render_recipe_sha256", "unreal_runtime", "exact_render_set", "resolution", "records", "records_sha256", "render_manifest_sha256", "scene_cleanup_state"],
      "properties": {
        "inspect_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "render_recipe_sha256": { "$ref": "#/$defs/sha256" },
        "unreal_runtime": {
          "type": "object", "additionalProperties": false,
          "required": ["deployment_identity", "runtime_image", "engine_revision", "whoami_sha256", "runtime_attestation_sha256"],
          "properties": {
            "deployment_identity": { "$ref": "#/$defs/safeId" }, "runtime_image": { "$ref": "#/$defs/image" },
            "engine_revision": { "$ref": "#/$defs/revision" }, "whoami_sha256": { "$ref": "#/$defs/sha256" },
            "runtime_attestation_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "exact_render_set": {
          "type": "object", "additionalProperties": false,
          "required": ["asset_count", "view_count", "ordered_asset_ids_sha256", "ordered_asset_view_pairs_sha256"],
          "properties": {
            "asset_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "view_count": { "type": "integer", "minimum": 1, "maximum": 131072 },
            "ordered_asset_ids_sha256": { "$ref": "#/$defs/sha256" },
            "ordered_asset_view_pairs_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "resolution": { "type": "object", "additionalProperties": false, "required": ["width", "height", "pixel_format"], "properties": { "width": { "type": "integer", "minimum": 64, "maximum": 8192 }, "height": { "type": "integer", "minimum": 64, "maximum": 8192 }, "pixel_format": { "const": "rgba8-srgb" } } },
        "records": { "type": "array", "minItems": 1, "maxItems": 131072, "items": { "$ref": "#/$defs/renderRecord" } },
        "records_sha256": { "$ref": "#/$defs/sha256" },
        "render_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "scene_cleanup_state": { "const": "destroyed_and_verified" }
      }
    },
    "semantic_validation": { "$ref": "#/$defs/semanticValidation" },
    "serialization_contract": { "$ref": "#/$defs/serializationContract" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha256Revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "safeId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-]*$" },
    "revision": { "type": "string", "minLength": 3, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]+$" },
    "generationId": { "type": "string", "pattern": "^semantic-generation:[a-f0-9]{64}$" },
    "assetId": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[a-z0-9][a-z0-9_]*$" },
    "image": { "type": "string", "minLength": 72, "maxLength": 512, "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$" },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "job_revision", "reviewed_job_sha256", "execution_plan_sha256", "approval_basis_sha256", "generation_id", "request_sha256", "phase_evidence_schema_sha256"],
      "properties": {
        "run_id": { "type": "string", "pattern": "^semantic-index-run:[A-Za-z0-9][A-Za-z0-9._:@+\\-]*$", "maxLength": 160 },
        "job_revision": { "$ref": "#/$defs/sha256Revision" }, "reviewed_job_sha256": { "$ref": "#/$defs/sha256" },
        "execution_plan_sha256": { "$ref": "#/$defs/sha256" }, "approval_basis_sha256": { "$ref": "#/$defs/sha256" },
        "generation_id": { "$ref": "#/$defs/generationId" }, "request_sha256": { "$ref": "#/$defs/sha256" },
        "phase_evidence_schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "chunk": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "content_address", "canonical_sha256", "canonical_byte_count", "record_count", "records_sha256"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "content_address": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" }, "canonical_byte_count": { "type": "integer", "minimum": 2, "maximum": 16777216 },
        "record_count": { "type": "integer", "minimum": 1, "maximum": 131072 }, "records_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "chunks": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/chunk" } },
    "rootRecomputation": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "phase_evidence_sha256", "ordered_chunks_sha256", "chunk_count", "record_count", "payload_byte_count", "preimage_fields", "artifact_root_sha256"],
      "properties": {
        "algorithm": { "const": "sha256-jcs-nul-separated-semantic-phase-artifact-root-v1" },
        "phase_evidence_sha256": { "$ref": "#/$defs/sha256" }, "ordered_chunks_sha256": { "$ref": "#/$defs/sha256" },
        "chunk_count": { "type": "integer", "minimum": 1, "maximum": 4096 }, "record_count": { "type": "integer", "minimum": 1, "maximum": 131072 },
        "payload_byte_count": { "type": "integer", "minimum": 2, "maximum": 68719476736 },
        "preimage_fields": { "type": "array", "prefixItems": [{"const":"schema"},{"const":"generation_id"},{"const":"request_sha256"},{"const":"phase_evidence_sha256"},{"const":"ordered_chunks_sha256"},{"const":"record_count"}], "items": false, "minItems": 6, "maxItems": 6 },
        "artifact_root_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "renderRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "asset_id", "view_id", "camera_transform_sha256", "inspect_record_sha256", "image", "linkage_sha256", "record_sha256"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 131071 }, "asset_id": { "$ref": "#/$defs/assetId" },
        "view_id": { "$ref": "#/$defs/safeId" }, "camera_transform_sha256": { "$ref": "#/$defs/sha256" }, "inspect_record_sha256": { "$ref": "#/$defs/sha256" },
        "image": {
          "type": "object", "additionalProperties": false,
          "required": ["artifact_id", "canonical_sha256", "byte_count", "width", "height", "format", "nonblank", "pixel_statistics_sha256"],
          "properties": {
            "artifact_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "canonical_sha256": { "$ref": "#/$defs/sha256" },
            "byte_count": { "type": "integer", "minimum": 64, "maximum": 268435456 }, "width": { "type": "integer", "minimum": 64, "maximum": 8192 },
            "height": { "type": "integer", "minimum": 64, "maximum": 8192 }, "format": { "const": "png" }, "nonblank": { "const": true },
            "pixel_statistics_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "linkage_sha256": { "$ref": "#/$defs/sha256" }, "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "semanticValidation": {
      "type": "object", "additionalProperties": false,
      "required": ["chunk_order", "chunk_uniqueness", "record_order", "record_uniqueness", "image_bytes_verified", "counts_and_digests_recomputed", "every_chunk_fetched"],
      "properties": {
        "chunk_order": { "const": "index_ascending_zero_based_without_gaps" },
        "chunk_uniqueness": { "const": "executor_linear_unique_index_content_address_and_digest_v1" },
        "record_order": { "const": "ordinal_then_asset_id_then_view_id_ascending" },
        "record_uniqueness": { "const": "executor_linear_unique_asset_id_and_view_id_v1" },
        "image_bytes_verified": { "const": true }, "counts_and_digests_recomputed": { "const": true }, "every_chunk_fetched": { "const": true }
      }
    },
    "serializationContract": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "canonicalization", "duplicate_keys", "unicode_normalization", "numbers", "nonfinite_numbers", "bom", "trailing_newline"],
      "properties": {
        "encoding": { "const": "utf-8" }, "canonicalization": { "const": "rfc8785-jcs-v1" }, "duplicate_keys": { "const": "reject" },
        "unicode_normalization": { "const": "require_already_nfc" }, "numbers": { "const": "integers_only" }, "nonfinite_numbers": { "const": "reject" },
        "bom": { "const": false }, "trailing_newline": { "const": false }
      }
    }
  }
}
