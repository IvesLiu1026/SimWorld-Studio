{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simworld.org/schemas/simworld-semantic-asset-index-execution-state-v2.schema.json",
  "title": "SimWorld semantic asset index append-only execution state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state_id", "bindings", "launcher_verification", "state_sequence", "prior_state_sha256", "phase_transitions", "progress", "prior_receipt_chain", "recovery_control_receipts", "mutation_tracking", "quarantine", "activation", "terminal", "append_only_contract", "serialization_contract"],
  "properties": {
    "schema": { "const": "simworld-semantic-asset-index-execution-state/v2" },
    "state_id": { "type": "string", "minLength": 25, "maxLength": 160, "pattern": "^semantic-index-state:[A-Za-z0-9][A-Za-z0-9._:@+\\-]*$" },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "correlation_id", "operator_id", "service_owner_id", "reviewed_job_schema", "reviewed_job_sha256", "job_revision", "execution_plan_schema", "execution_plan_sha256", "approval_basis_schema", "approval_basis_sha256", "generation_id", "generation_reservation_receipt_sha256"],
      "properties": {
        "run_id": { "$ref": "#/$defs/runId" }, "correlation_id": { "$ref": "#/$defs/correlationId" }, "operator_id": { "$ref": "#/$defs/safeId" }, "service_owner_id": { "$ref": "#/$defs/safeId" },
        "reviewed_job_schema": { "const": "simworld-semantic-asset-index-job/v2" }, "reviewed_job_sha256": { "$ref": "#/$defs/sha256" }, "job_revision": { "$ref": "#/$defs/sha256Revision" },
        "execution_plan_schema": { "const": "simworld-semantic-asset-index-execution-plan/v2" }, "execution_plan_sha256": { "$ref": "#/$defs/sha256" },
        "approval_basis_schema": { "const": "simworld-semantic-index-production-approval-basis/v1" }, "approval_basis_sha256": { "$ref": "#/$defs/sha256" },
        "generation_id": { "$ref": "#/$defs/generationId" }, "generation_reservation_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "launcher_verification": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_schema", "receipt_sha256", "launcher_identity", "launcher_uid", "coordinator_uid", "opaque_handoff_verified", "source_closure_sha256", "plan_sha256", "runtime_attestation_sha256"],
      "properties": {
        "receipt_schema": { "const": "simworld-semantic-index-launcher-verification-receipt/v1" }, "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "launcher_identity": { "$ref": "#/$defs/safeId" }, "launcher_uid": { "type": "integer", "minimum": 0, "maximum": 2147483647 }, "coordinator_uid": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "opaque_handoff_verified": { "const": true }, "source_closure_sha256": { "$ref": "#/$defs/sha256" }, "plan_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_attestation_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "state_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "prior_state_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "phase_transitions": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/inspectTransition" }, { "$ref": "#/$defs/renderTransition" }, { "$ref": "#/$defs/captionTransition" },
        { "$ref": "#/$defs/embedTransition" }, { "$ref": "#/$defs/postgresTransition" }, { "$ref": "#/$defs/qdrantTransition" }, { "$ref": "#/$defs/reconcileTransition" }
      ],
      "items": false, "maxItems": 7
    },
    "progress": {
      "type": "object", "additionalProperties": false,
      "required": ["completed_phase_count", "last_completed_phase", "next_phase"],
      "properties": {
        "completed_phase_count": { "type": "integer", "minimum": 0, "maximum": 7 },
        "last_completed_phase": { "oneOf": [{ "enum": ["inspect", "render", "caption", "embed", "postgres", "qdrant", "reconcile"] }, { "type": "null" }] },
        "next_phase": { "oneOf": [{ "enum": ["inspect", "render", "caption", "embed", "postgres", "qdrant", "reconcile"] }, { "type": "null" }] }
      }
    },
    "prior_receipt_chain": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/inspectReceiptChainEntry" }, { "$ref": "#/$defs/renderReceiptChainEntry" },
        { "$ref": "#/$defs/captionReceiptChainEntry" }, { "$ref": "#/$defs/embedReceiptChainEntry" },
        { "$ref": "#/$defs/postgresReceiptChainEntry" }, { "$ref": "#/$defs/qdrantReceiptChainEntry" },
        { "$ref": "#/$defs/reconcileReceiptChainEntry" }
      ],
      "items": false,
      "maxItems": 7
    },
    "recovery_control_receipts": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/controlReceipt" } },
    "mutation_tracking": {
      "type": "object", "additionalProperties": false,
      "required": ["current_state", "last_phase", "last_request_sha256", "ordinary_retry_permitted", "ambiguous_requires_operator", "generation_isolated", "active_pointer_unchanged"],
      "properties": {
        "current_state": { "enum": ["none", "staged", "committed", "ambiguous"] },
        "last_phase": { "oneOf": [{ "enum": ["inspect", "render", "caption", "embed", "postgres", "qdrant", "reconcile"] }, { "type": "null" }] },
        "last_request_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "ordinary_retry_permitted": { "type": "boolean" }, "ambiguous_requires_operator": { "type": "boolean" },
        "generation_isolated": { "const": true }, "active_pointer_unchanged": { "const": true }
      }
    },
    "quarantine": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state", "control_request_sha256", "control_receipt_sha256", "targets_only_new_generation"], "properties": { "state": { "const": "not_requested" }, "control_request_sha256": { "type": "null" }, "control_receipt_sha256": { "type": "null" }, "targets_only_new_generation": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["state", "control_request_sha256", "control_receipt_sha256", "targets_only_new_generation"], "properties": { "state": { "const": "requested" }, "control_request_sha256": { "$ref": "#/$defs/sha256" }, "control_receipt_sha256": { "type": "null" }, "targets_only_new_generation": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["state", "control_request_sha256", "control_receipt_sha256", "targets_only_new_generation"], "properties": { "state": { "const": "confirmed" }, "control_request_sha256": { "$ref": "#/$defs/sha256" }, "control_receipt_sha256": { "$ref": "#/$defs/sha256" }, "targets_only_new_generation": { "const": true } } }
      ]
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "activation_authorized", "activation_performed", "active_pointer_identity", "observed_epoch", "pointer_unchanged"],
      "properties": {
        "state": { "const": "off" }, "activation_authorized": { "const": false }, "activation_performed": { "const": false },
        "active_pointer_identity": { "$ref": "#/$defs/safeId" }, "observed_epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "pointer_unchanged": { "const": true }
      }
    },
    "terminal": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["lifecycle", "verified", "terminal_receipt_sha256"], "properties": { "lifecycle": { "const": "running" }, "verified": { "const": false }, "terminal_receipt_sha256": { "type": "null" } } },
        { "type": "object", "additionalProperties": false, "required": ["lifecycle", "verified", "terminal_receipt_sha256"], "properties": { "lifecycle": { "const": "snapshot_built_verified" }, "verified": { "const": true }, "terminal_receipt_sha256": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["lifecycle", "verified", "terminal_receipt_sha256"], "properties": { "lifecycle": { "const": "recovery_required" }, "verified": { "const": false }, "terminal_receipt_sha256": { "$ref": "#/$defs/sha256" } } },
        { "type": "object", "additionalProperties": false, "required": ["lifecycle", "verified", "terminal_receipt_sha256"], "properties": { "lifecycle": { "const": "failed_quarantined" }, "verified": { "const": false }, "terminal_receipt_sha256": { "$ref": "#/$defs/sha256" } } }
      ]
    },
    "append_only_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["update_mode", "phase_order", "phase_transition_uniqueness", "receipt_chain_validation", "control_receipt_order", "no_in_place_rewrite"],
      "properties": {
        "update_mode": { "const": "publish_new_canonical_state_no_replace_v1" },
        "phase_order": { "const": "fixed_seven_phase_prefix_only" },
        "phase_transition_uniqueness": { "const": "executor_linear_unique_phase_request_evidence_and_transition_digest_v1" },
        "receipt_chain_validation": { "const": "executor_recomputes_every_prior_link_v1" },
        "control_receipt_order": { "const": "sequence_ascending_zero_based_without_gaps" },
        "no_in_place_rewrite": { "const": true }
      }
    },
    "serialization_contract": { "$ref": "#/$defs/serializationContract" }
  },
  "allOf": [
    {
      "oneOf": [
        { "properties": { "phase_transitions": { "maxItems": 0 }, "prior_receipt_chain": { "maxItems": 0 }, "progress": { "properties": { "completed_phase_count": { "const": 0 }, "last_completed_phase": { "type": "null" }, "next_phase": { "const": "inspect" } } } } },
        { "properties": { "phase_transitions": { "minItems": 1, "maxItems": 1 }, "prior_receipt_chain": { "minItems": 1, "maxItems": 1 }, "progress": { "properties": { "completed_phase_count": { "const": 1 }, "last_completed_phase": { "const": "inspect" }, "next_phase": { "const": "render" } } } } },
        { "properties": { "phase_transitions": { "minItems": 2, "maxItems": 2 }, "prior_receipt_chain": { "minItems": 2, "maxItems": 2 }, "progress": { "properties": { "completed_phase_count": { "const": 2 }, "last_completed_phase": { "const": "render" }, "next_phase": { "const": "caption" } } } } },
        { "properties": { "phase_transitions": { "minItems": 3, "maxItems": 3 }, "prior_receipt_chain": { "minItems": 3, "maxItems": 3 }, "progress": { "properties": { "completed_phase_count": { "const": 3 }, "last_completed_phase": { "const": "caption" }, "next_phase": { "const": "embed" } } } } },
        { "properties": { "phase_transitions": { "minItems": 4, "maxItems": 4 }, "prior_receipt_chain": { "minItems": 4, "maxItems": 4 }, "progress": { "properties": { "completed_phase_count": { "const": 4 }, "last_completed_phase": { "const": "embed" }, "next_phase": { "const": "postgres" } } } } },
        { "properties": { "phase_transitions": { "minItems": 5, "maxItems": 5 }, "prior_receipt_chain": { "minItems": 5, "maxItems": 5 }, "progress": { "properties": { "completed_phase_count": { "const": 5 }, "last_completed_phase": { "const": "postgres" }, "next_phase": { "const": "qdrant" } } } } },
        { "properties": { "phase_transitions": { "minItems": 6, "maxItems": 6 }, "prior_receipt_chain": { "minItems": 6, "maxItems": 6 }, "progress": { "properties": { "completed_phase_count": { "const": 6 }, "last_completed_phase": { "const": "qdrant" }, "next_phase": { "const": "reconcile" } } } } },
        { "properties": { "phase_transitions": { "minItems": 7, "maxItems": 7 }, "prior_receipt_chain": { "minItems": 7, "maxItems": 7 }, "progress": { "properties": { "completed_phase_count": { "const": 7 }, "last_completed_phase": { "const": "reconcile" }, "next_phase": { "type": "null" } } } } }
      ]
    },
    {
      "if": { "properties": { "terminal": { "properties": { "lifecycle": { "const": "snapshot_built_verified" } }, "required": ["lifecycle"] } }, "required": ["terminal"] },
      "then": { "properties": { "phase_transitions": { "minItems": 7, "maxItems": 7 }, "progress": { "properties": { "completed_phase_count": { "const": 7 } } } } }
    },
    {
      "if": { "properties": { "mutation_tracking": { "properties": { "current_state": { "const": "ambiguous" } }, "required": ["current_state"] } }, "required": ["mutation_tracking"] },
      "then": { "properties": { "mutation_tracking": { "properties": { "ordinary_retry_permitted": { "const": false }, "ambiguous_requires_operator": { "const": true } } } } }
    },
    {
      "if": { "properties": { "mutation_tracking": { "properties": { "current_state": { "enum": ["staged", "committed"] } }, "required": ["current_state"] } }, "required": ["mutation_tracking"] },
      "then": { "properties": { "mutation_tracking": { "properties": { "ordinary_retry_permitted": { "const": false } } } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "sha256Revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "safeId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-]*$" },
    "runId": { "type": "string", "minLength": 23, "maxLength": 160, "pattern": "^semantic-index-run:[A-Za-z0-9][A-Za-z0-9._:@+\\-]*$" },
    "correlationId": { "type": "string", "minLength": 27, "maxLength": 160, "pattern": "^semantic-index-correlation:[A-Za-z0-9][A-Za-z0-9._:@+\\-]*$" },
    "generationId": { "type": "string", "pattern": "^semantic-generation:[a-f0-9]{64}$" },
    "rfc3339": { "type": "string", "minLength": 20, "maxLength": 35, "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "phase", "operation", "from_state", "to_state", "request_sha256", "phase_evidence_sha256", "artifact_root_sha256", "prior_transition_sha256", "transition_sha256", "mutation_state", "committed_at"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0, "maximum": 6 }, "phase": { "enum": ["inspect", "render", "caption", "embed", "postgres", "qdrant", "reconcile"] },
        "operation": { "enum": ["inspect_exact_assets", "render_exact_views", "caption_exact_render_set", "embed_exact_text_set", "upsert_postgres_exact", "upsert_qdrant_exact", "reconcile_exact_snapshot"] },
        "from_state": { "$ref": "#/$defs/safeId" }, "to_state": { "$ref": "#/$defs/safeId" }, "request_sha256": { "$ref": "#/$defs/sha256" },
        "phase_evidence_sha256": { "$ref": "#/$defs/sha256" }, "artifact_root_sha256": { "$ref": "#/$defs/sha256" },
        "prior_transition_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "transition_sha256": { "$ref": "#/$defs/sha256" },
        "mutation_state": { "enum": ["none", "staged", "committed"] }, "committed_at": { "$ref": "#/$defs/rfc3339" }
      }
    },
    "inspectTransition": { "allOf": [{ "$ref": "#/$defs/transition" }, { "properties": { "sequence": { "const": 0 }, "phase": { "const": "inspect" }, "operation": { "const": "inspect_exact_assets" }, "from_state": { "const": "reserved" }, "to_state": { "const": "inspect_evidence_committed" }, "prior_transition_sha256": { "type": "null" }, "mutation_state": { "const": "none" } } }] },
    "renderTransition": { "allOf": [{ "$ref": "#/$defs/transition" }, { "properties": { "sequence": { "const": 1 }, "phase": { "const": "render" }, "operation": { "const": "render_exact_views" }, "from_state": { "const": "inspect_evidence_committed" }, "to_state": { "const": "render_evidence_committed" }, "prior_transition_sha256": { "$ref": "#/$defs/sha256" }, "mutation_state": { "const": "staged" } } }] },
    "captionTransition": { "allOf": [{ "$ref": "#/$defs/transition" }, { "properties": { "sequence": { "const": 2 }, "phase": { "const": "caption" }, "operation": { "const": "caption_exact_render_set" }, "from_state": { "const": "render_evidence_committed" }, "to_state": { "const": "caption_evidence_committed" }, "prior_transition_sha256": { "$ref": "#/$defs/sha256" }, "mutation_state": { "const": "committed" } } }] },
    "embedTransition": { "allOf": [{ "$ref": "#/$defs/transition" }, { "properties": { "sequence": { "const": 3 }, "phase": { "const": "embed" }, "operation": { "const": "embed_exact_text_set" }, "from_state": { "const": "caption_evidence_committed" }, "to_state": { "const": "embed_evidence_committed" }, "prior_transition_sha256": { "$ref": "#/$defs/sha256" }, "mutation_state": { "const": "staged" } } }] },
    "postgresTransition": { "allOf": [{ "$ref": "#/$defs/transition" }, { "properties": { "sequence": { "const": 4 }, "phase": { "const": "postgres" }, "operation": { "const": "upsert_postgres_exact" }, "from_state": { "const": "embed_evidence_committed" }, "to_state": { "const": "postgres_evidence_committed" }, "prior_transition_sha256": { "$ref": "#/$defs/sha256" }, "mutation_state": { "const": "committed" } } }] },
    "qdrantTransition": { "allOf": [{ "$ref": "#/$defs/transition" }, { "properties": { "sequence": { "const": 5 }, "phase": { "const": "qdrant" }, "operation": { "const": "upsert_qdrant_exact" }, "from_state": { "const": "postgres_evidence_committed" }, "to_state": { "const": "qdrant_evidence_committed" }, "prior_transition_sha256": { "$ref": "#/$defs/sha256" }, "mutation_state": { "const": "committed" } } }] },
    "reconcileTransition": { "allOf": [{ "$ref": "#/$defs/transition" }, { "properties": { "sequence": { "const": 6 }, "phase": { "const": "reconcile" }, "operation": { "const": "reconcile_exact_snapshot" }, "from_state": { "const": "qdrant_evidence_committed" }, "to_state": { "const": "reconcile_evidence_committed" }, "prior_transition_sha256": { "$ref": "#/$defs/sha256" }, "mutation_state": { "const": "none" } } }] },
    "receiptChainEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "phase", "request_sha256", "phase_evidence_sha256", "artifact_root_sha256", "prior_phase_evidence_sha256"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0, "maximum": 6 }, "phase": { "enum": ["inspect", "render", "caption", "embed", "postgres", "qdrant", "reconcile"] },
        "request_sha256": { "$ref": "#/$defs/sha256" }, "phase_evidence_sha256": { "$ref": "#/$defs/sha256" }, "artifact_root_sha256": { "$ref": "#/$defs/sha256" },
        "prior_phase_evidence_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "inspectReceiptChainEntry": { "allOf": [{ "$ref": "#/$defs/receiptChainEntry" }, { "properties": { "sequence": { "const": 0 }, "phase": { "const": "inspect" }, "prior_phase_evidence_sha256": { "type": "null" } } }] },
    "renderReceiptChainEntry": { "allOf": [{ "$ref": "#/$defs/receiptChainEntry" }, { "properties": { "sequence": { "const": 1 }, "phase": { "const": "render" }, "prior_phase_evidence_sha256": { "$ref": "#/$defs/sha256" } } }] },
    "captionReceiptChainEntry": { "allOf": [{ "$ref": "#/$defs/receiptChainEntry" }, { "properties": { "sequence": { "const": 2 }, "phase": { "const": "caption" }, "prior_phase_evidence_sha256": { "$ref": "#/$defs/sha256" } } }] },
    "embedReceiptChainEntry": { "allOf": [{ "$ref": "#/$defs/receiptChainEntry" }, { "properties": { "sequence": { "const": 3 }, "phase": { "const": "embed" }, "prior_phase_evidence_sha256": { "$ref": "#/$defs/sha256" } } }] },
    "postgresReceiptChainEntry": { "allOf": [{ "$ref": "#/$defs/receiptChainEntry" }, { "properties": { "sequence": { "const": 4 }, "phase": { "const": "postgres" }, "prior_phase_evidence_sha256": { "$ref": "#/$defs/sha256" } } }] },
    "qdrantReceiptChainEntry": { "allOf": [{ "$ref": "#/$defs/receiptChainEntry" }, { "properties": { "sequence": { "const": 5 }, "phase": { "const": "qdrant" }, "prior_phase_evidence_sha256": { "$ref": "#/$defs/sha256" } } }] },
    "reconcileReceiptChainEntry": { "allOf": [{ "$ref": "#/$defs/receiptChainEntry" }, { "properties": { "sequence": { "const": 6 }, "phase": { "const": "reconcile" }, "prior_phase_evidence_sha256": { "$ref": "#/$defs/sha256" } } }] },
    "controlReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "operation", "phase", "idempotency_key", "original_phase_request_sha256", "request_sha256", "result_sha256", "status", "mutation_state", "retryable", "prior_control_receipt_sha256", "issued_at"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0, "maximum": 63 }, "operation": { "enum": ["query_phase_status", "recover_phase_receipt", "cancel_phase_work", "quarantine_generation"] },
        "phase": { "enum": ["inspect", "render", "caption", "embed", "postgres", "qdrant", "reconcile"] }, "idempotency_key": { "$ref": "#/$defs/sha256Revision" },
        "original_phase_request_sha256": { "$ref": "#/$defs/sha256" }, "request_sha256": { "$ref": "#/$defs/sha256" }, "result_sha256": { "$ref": "#/$defs/sha256" }, "status": { "enum": ["succeeded", "failed"] },
        "mutation_state": { "enum": ["none", "committed", "ambiguous"] }, "prior_control_receipt_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "retryable": { "type": "boolean" }, "issued_at": { "$ref": "#/$defs/rfc3339" }
      },
      "allOf": [
        { "if": { "properties": { "operation": { "enum": ["query_phase_status", "recover_phase_receipt"] } }, "required": ["operation"] }, "then": { "properties": { "mutation_state": { "const": "none" } } } },
        { "if": { "properties": { "operation": { "enum": ["cancel_phase_work", "quarantine_generation"] }, "status": { "const": "succeeded" } }, "required": ["operation", "status"] }, "then": { "properties": { "mutation_state": { "const": "committed" }, "retryable": { "const": false } } } },
        { "if": { "properties": { "mutation_state": { "enum": ["committed", "ambiguous"] } }, "required": ["mutation_state"] }, "then": { "properties": { "retryable": { "const": false } } } }
      ]
    },
    "serializationContract": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "canonicalization", "duplicate_keys", "unicode_normalization", "numbers", "nonfinite_numbers", "bom", "trailing_newline"],
      "properties": {
        "encoding": { "const": "utf-8" }, "canonicalization": { "const": "rfc8785-jcs-v1" }, "duplicate_keys": { "const": "reject" },
        "unicode_normalization": { "const": "require_already_nfc" }, "numbers": { "const": "integers_only" }, "nonfinite_numbers": { "const": "reject" },
        "bom": { "const": false }, "trailing_newline": { "const": false }
      }
    }
  }
}
