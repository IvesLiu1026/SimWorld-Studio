{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simworld.org/schemas/simworld-semantic-index-worker-artifact-root-v1.schema.json",
  "title": "SimWorld semantic index worker artifact root envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol",
    "phase",
    "operation",
    "request_sha256",
    "job_revision",
    "reviewed_job_sha256",
    "approval_basis_sha256",
    "execution_plan_sha256",
    "generation_id",
    "generation_binding_sha256",
    "idempotency_key",
    "idempotency_ledger_identity",
    "idempotency_ledger_revision",
    "input_artifact_sha256",
    "artifact_root",
    "observed_targets",
    "worker_attestation",
    "issued_at",
    "expires_at",
    "serialization_contract"
  ],
  "properties": {
    "schema": { "const": "simworld-semantic-index-worker-artifact-root/v1" },
    "protocol": { "const": "simworld-semantic-index-worker/v1" },
    "phase": {
      "enum": ["inspect", "render", "caption", "embed", "postgres", "qdrant", "reconcile"]
    },
    "operation": {
      "enum": [
        "inspect_exact_assets",
        "render_exact_views",
        "caption_exact_render_set",
        "embed_exact_text_set",
        "upsert_postgres_exact",
        "upsert_qdrant_exact",
        "reconcile_exact_snapshot"
      ]
    },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "job_revision": { "$ref": "#/$defs/sha256Revision" },
    "reviewed_job_sha256": { "$ref": "#/$defs/sha256" },
    "approval_basis_sha256": { "$ref": "#/$defs/sha256" },
    "execution_plan_sha256": { "$ref": "#/$defs/sha256" },
    "generation_id": { "$ref": "#/$defs/generationId" },
    "generation_binding_sha256": { "$ref": "#/$defs/sha256" },
    "idempotency_key": { "$ref": "#/$defs/sha256Revision" },
    "idempotency_ledger_identity": { "$ref": "#/$defs/safeId" },
    "idempotency_ledger_revision": { "$ref": "#/$defs/sha256Revision" },
    "input_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "artifact_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sha256", "byte_count", "chunk_count", "chunks_sha256"],
      "properties": {
        "schema": {
          "enum": [
            "simworld-semantic-index-inspect-artifact/v1",
            "simworld-semantic-index-render-artifact/v1",
            "simworld-semantic-index-caption-artifact/v1",
            "simworld-semantic-index-embed-artifact/v1",
            "simworld-semantic-index-postgres-artifact/v1",
            "simworld-semantic-index-qdrant-artifact/v1",
            "simworld-semantic-index-reconcile-artifact/v1"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "chunk_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "chunks_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "observed_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/targetObservation" }
    },
    "worker_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_identity",
        "runtime_image",
        "whoami_sha256",
        "peer_attestation_sha256",
        "runtime_attestation_sha256",
        "host_boot_id_sha256",
        "process_start_token_sha256",
        "socket_inode_binding_sha256"
      ],
      "properties": {
        "deployment_identity": { "$ref": "#/$defs/safeId" },
        "runtime_image": { "$ref": "#/$defs/image" },
        "whoami_sha256": { "$ref": "#/$defs/sha256" },
        "peer_attestation_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_attestation_sha256": { "$ref": "#/$defs/sha256" },
        "host_boot_id_sha256": { "$ref": "#/$defs/sha256" },
        "process_start_token_sha256": { "$ref": "#/$defs/sha256" },
        "socket_inode_binding_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "issued_at": { "$ref": "#/$defs/rfc3339" },
    "expires_at": { "$ref": "#/$defs/rfc3339" },
    "serialization_contract": { "$ref": "#/$defs/serializationContract" }
  },
  "allOf": [
    { "$ref": "#/$defs/inspectContract" },
    { "$ref": "#/$defs/renderContract" },
    { "$ref": "#/$defs/captionContract" },
    { "$ref": "#/$defs/embedContract" },
    { "$ref": "#/$defs/postgresContract" },
    { "$ref": "#/$defs/qdrantContract" },
    { "$ref": "#/$defs/reconcileContract" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha256Revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-]*$"
    },
    "generationId": {
      "type": "string",
      "minLength": 84,
      "maxLength": 84,
      "pattern": "^semantic-generation:[a-f0-9]{64}$"
    },
    "image": {
      "type": "string",
      "minLength": 72,
      "maxLength": 512,
      "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "minLength": 20,
      "maxLength": 35,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "targetObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "scope",
        "credential_generation",
        "generation_id",
        "target_identity",
        "runtime_identity",
        "runtime_image",
        "whoami_sha256",
        "runtime_attestation_sha256"
      ],
      "properties": {
        "component": { "enum": ["unreal", "caption", "embedding", "postgres", "qdrant"] },
        "scope": { "$ref": "#/$defs/safeId" },
        "credential_generation": { "$ref": "#/$defs/sha256Revision" },
        "generation_id": { "$ref": "#/$defs/generationId" },
        "target_identity": { "$ref": "#/$defs/safeId" },
        "runtime_identity": { "$ref": "#/$defs/safeId" },
        "runtime_image": {
          "oneOf": [{ "$ref": "#/$defs/image" }, { "type": "null" }]
        },
        "whoami_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_attestation_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "singleTarget": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1
    },
    "inspectContract": {
      "if": { "properties": { "phase": { "const": "inspect" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "operation": { "const": "inspect_exact_assets" },
          "artifact_root": { "properties": { "schema": { "const": "simworld-semantic-index-inspect-artifact/v1" } } },
          "observed_targets": {
            "allOf": [
              { "$ref": "#/$defs/singleTarget" },
              { "prefixItems": [{ "properties": { "component": { "const": "unreal" }, "scope": { "const": "ue_disposable_scene_inspect_spawn_cleanup" }, "runtime_image": { "$ref": "#/$defs/image" } } }] }
            ]
          }
        }
      }
    },
    "renderContract": {
      "if": { "properties": { "phase": { "const": "render" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "operation": { "const": "render_exact_views" },
          "artifact_root": { "properties": { "schema": { "const": "simworld-semantic-index-render-artifact/v1" } } },
          "observed_targets": {
            "allOf": [
              { "$ref": "#/$defs/singleTarget" },
              { "prefixItems": [{ "properties": { "component": { "const": "unreal" }, "scope": { "const": "ue_disposable_scene_render_staging_cleanup" }, "runtime_image": { "$ref": "#/$defs/image" } } }] }
            ]
          }
        }
      }
    },
    "captionContract": {
      "if": { "properties": { "phase": { "const": "caption" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "operation": { "const": "caption_exact_render_set" },
          "artifact_root": { "properties": { "schema": { "const": "simworld-semantic-index-caption-artifact/v1" } } },
          "observed_targets": {
            "allOf": [
              { "$ref": "#/$defs/singleTarget" },
              { "prefixItems": [{ "properties": { "component": { "const": "caption" }, "scope": { "const": "caption_bounded_idempotent_call" }, "runtime_image": { "type": "null" } } }] }
            ]
          }
        }
      }
    },
    "embedContract": {
      "if": { "properties": { "phase": { "const": "embed" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "operation": { "const": "embed_exact_text_set" },
          "artifact_root": { "properties": { "schema": { "const": "simworld-semantic-index-embed-artifact/v1" } } },
          "observed_targets": {
            "allOf": [
              { "$ref": "#/$defs/singleTarget" },
              { "prefixItems": [{ "properties": { "component": { "const": "embedding" }, "scope": { "const": "embedding_immutable_vector_staging" }, "runtime_image": { "$ref": "#/$defs/image" } } }] }
            ]
          }
        }
      }
    },
    "postgresContract": {
      "if": { "properties": { "phase": { "const": "postgres" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "operation": { "const": "upsert_postgres_exact" },
          "artifact_root": { "properties": { "schema": { "const": "simworld-semantic-index-postgres-artifact/v1" } } },
          "observed_targets": {
            "allOf": [
              { "$ref": "#/$defs/singleTarget" },
              { "prefixItems": [{ "properties": { "component": { "const": "postgres" }, "scope": { "const": "postgres_generation_write" }, "runtime_image": { "$ref": "#/$defs/image" } } }] }
            ]
          }
        }
      }
    },
    "qdrantContract": {
      "if": { "properties": { "phase": { "const": "qdrant" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "operation": { "const": "upsert_qdrant_exact" },
          "artifact_root": { "properties": { "schema": { "const": "simworld-semantic-index-qdrant-artifact/v1" } } },
          "observed_targets": {
            "allOf": [
              { "$ref": "#/$defs/singleTarget" },
              { "prefixItems": [{ "properties": { "component": { "const": "qdrant" }, "scope": { "const": "qdrant_generation_write" }, "runtime_image": { "$ref": "#/$defs/image" } } }] }
            ]
          }
        }
      }
    },
    "reconcileContract": {
      "if": { "properties": { "phase": { "const": "reconcile" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "operation": { "const": "reconcile_exact_snapshot" },
          "artifact_root": { "properties": { "schema": { "const": "simworld-semantic-index-reconcile-artifact/v1" } } },
          "observed_targets": {
            "prefixItems": [
              { "properties": { "component": { "const": "postgres" }, "scope": { "const": "postgres_generation_read_only" }, "runtime_image": { "$ref": "#/$defs/image" } } },
              { "properties": { "component": { "const": "qdrant" }, "scope": { "const": "qdrant_generation_read_only" }, "runtime_image": { "$ref": "#/$defs/image" } } },
              { "properties": { "component": { "const": "unreal" }, "scope": { "const": "ue_runtime_read_only" }, "runtime_image": { "$ref": "#/$defs/image" } } }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "serializationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "canonicalization",
        "duplicate_keys",
        "unicode_normalization",
        "numbers",
        "nonfinite_numbers",
        "trailing_newline"
      ],
      "properties": {
        "encoding": { "const": "utf-8" },
        "canonicalization": { "const": "rfc8785-jcs-v1" },
        "duplicate_keys": { "const": "reject" },
        "unicode_normalization": { "const": "require_already_nfc" },
        "numbers": { "const": "integers_only" },
        "nonfinite_numbers": { "const": "reject" },
        "trailing_newline": { "const": false }
      }
    }
  }
}
