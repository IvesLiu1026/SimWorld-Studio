{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simworld.org/schemas/vista-playable-event-v1.schema.json",
  "title": "VISTA Playable Event v1 (public runtime contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "title",
    "compatible_house",
    "participating_room_ids",
    "participating_entity_ids",
    "initial_operations",
    "public_goals",
    "triggers",
    "success_conditions",
    "failure_conditions",
    "timeout_s",
    "reset_policy",
    "source",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "simworld.vista.playable-event/v1"},
    "event_id": {"$ref": "#/$defs/eventId"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "compatible_house": {"$ref": "#/$defs/compatibleHouse"},
    "participating_room_ids": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": {"$ref": "#/$defs/roomId"}
    },
    "participating_entity_ids": {
      "type": "array", "minItems": 1, "maxItems": 2048, "uniqueItems": true,
      "items": {"$ref": "#/$defs/entityId"}
    },
    "initial_operations": {
      "type": "array", "maxItems": 4096,
      "items": {"$ref": "#/$defs/operation"}
    },
    "public_goals": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {"$ref": "#/$defs/publicGoal"}
    },
    "triggers": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/condition"}
    },
    "success_conditions": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/condition"}
    },
    "failure_conditions": {
      "type": "array", "maxItems": 256,
      "items": {"$ref": "#/$defs/condition"}
    },
    "timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
    "reset_policy": {"$ref": "#/$defs/resetPolicy"},
    "source": {"$ref": "#/$defs/source"},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eventId": {"type": "string", "pattern": "^mmg_[0-9]{3}$"},
    "houseId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 96},
    "revision": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_r[0-9]+$", "maxLength": 96},
    "roomId": {"type": "string", "pattern": "^home\\.r[0-9]+/room\\.[a-z][a-z0-9_]*$", "maxLength": 128},
    "entityId": {"type": "string", "pattern": "^home\\.r[0-9]+/room\\.[a-z][a-z0-9_]*/entity\\.[a-z][a-z0-9_]*\\.[0-9]{2}$", "maxLength": 192},
    "assetId": {"type": "string", "pattern": "^asset\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 96},
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": -1000000, "maximum": 1000000},
        {"type": "number", "minimum": -1000000, "maximum": 1000000},
        {"type": "number", "minimum": -1000000, "maximum": 1000000}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "rotation3": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": -360, "maximum": 360},
        {"type": "number", "minimum": -360, "maximum": 360},
        {"type": "number", "minimum": -360, "maximum": 360}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "scale3": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_m", "rotation_deg", "scale"],
      "properties": {
        "location_m": {"$ref": "#/$defs/vector3"},
        "rotation_deg": {"$ref": "#/$defs/rotation3"},
        "scale": {"$ref": "#/$defs/scale3"}
      }
    },
    "statePatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "open": {"type": "boolean"},
        "active": {"type": "boolean"},
        "powered": {"type": "boolean"},
        "portable": {"type": "boolean"},
        "visible": {"type": "boolean"},
        "occupied": {"type": "boolean"},
        "filled": {"type": "boolean"},
        "liquid_level": {"type": "number", "minimum": 0, "maximum": 1},
        "hazard": {"enum": ["none", "thermal", "spill", "overflow", "unstable", "obstacle"]},
        "held_by": {"oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9._/-]*$", "maxLength": 128}, {"type": "null"}]},
        "placed_at": {"oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9._/#-]*$", "maxLength": 224}, {"type": "null"}]},
        "status": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
        "inspect_text": {"type": "string", "maxLength": 320}
      }
    },
    "compatibleHouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["house_id", "revision", "content_digest"],
      "properties": {
        "house_id": {"$ref": "#/$defs/houseId"},
        "revision": {"$ref": "#/$defs/revision"},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "action": {
      "oneOf": [
        {"$ref": "#/$defs/navigateAction"},
        {"$ref": "#/$defs/lookAction"},
        {"$ref": "#/$defs/entityAction"},
        {"$ref": "#/$defs/waitAction"},
        {"$ref": "#/$defs/speakAction"}
      ]
    },
    "navigateAction": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "room_id"],
      "properties": {
        "action": {"const": "navigate_to"},
        "room_id": {"$ref": "#/$defs/roomId"}
      }
    },
    "lookAction": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "target_id"],
      "properties": {
        "action": {"const": "look_at"},
        "target_id": {"$ref": "#/$defs/entityId"}
      }
    },
    "entityAction": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "target_id"],
      "properties": {
        "action": {"enum": ["pick_up", "place", "open_door", "close_door", "sit"]},
        "target_id": {"$ref": "#/$defs/entityId"}
      }
    },
    "waitAction": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "duration_s"],
      "properties": {
        "action": {"const": "wait"},
        "duration_s": {"type": "number", "minimum": 0, "maximum": 300}
      }
    },
    "speakAction": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "utterance"],
      "properties": {
        "action": {"const": "speak"},
        "utterance": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/spawnFixtureOperation"},
        {"$ref": "#/$defs/setTransformOperation"},
        {"$ref": "#/$defs/setStateOperation"},
        {"$ref": "#/$defs/setVisibilityOperation"},
        {"$ref": "#/$defs/setPortableOperation"},
        {"$ref": "#/$defs/setNpcQueueOperation"},
        {"$ref": "#/$defs/setGoalOperation"}
      ]
    },
    "opId": {"type": "string", "pattern": "^op\\.[0-9]{2,4}$"},
    "spawnFixtureOperation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "op_id", "op", "entity_id", "room_id", "category", "asset_ref", "transform",
        "component_role", "mobility", "collision_policy", "affordances", "initial_state"
      ],
      "properties": {
        "op_id": {"$ref": "#/$defs/opId"},
        "op": {"const": "spawn_fixture"},
        "entity_id": {"$ref": "#/$defs/entityId"},
        "room_id": {"$ref": "#/$defs/roomId"},
        "category": {"$ref": "#/$defs/slug"},
        "asset_ref": {"$ref": "#/$defs/assetId"},
        "transform": {"$ref": "#/$defs/transform"},
        "component_role": {"enum": ["decoration", "pickup", "hazard", "anchor"]},
        "mobility": {"enum": ["static", "movable", "simulated"]},
        "collision_policy": {"enum": ["detail_no_collision", "pickup_physics", "trigger_only"]},
        "affordances": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {"enum": ["pick_up", "drop", "place", "inspect"]}
        },
        "initial_state": {"$ref": "#/$defs/statePatch"}
      }
    },
    "setTransformOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["op_id", "op", "target_id", "room_id", "transform"],
      "properties": {
        "op_id": {"$ref": "#/$defs/opId"},
        "op": {"const": "set_transform"},
        "target_id": {"$ref": "#/$defs/entityId"},
        "room_id": {"$ref": "#/$defs/roomId"},
        "transform": {"$ref": "#/$defs/transform"}
      }
    },
    "setStateOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["op_id", "op", "target_id", "state_patch"],
      "properties": {
        "op_id": {"$ref": "#/$defs/opId"},
        "op": {"const": "set_state"},
        "target_id": {"$ref": "#/$defs/entityId"},
        "state_patch": {"$ref": "#/$defs/statePatch"}
      }
    },
    "setVisibilityOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["op_id", "op", "target_id", "visible"],
      "properties": {
        "op_id": {"$ref": "#/$defs/opId"},
        "op": {"const": "set_visibility"},
        "target_id": {"$ref": "#/$defs/entityId"},
        "visible": {"type": "boolean"}
      }
    },
    "setPortableOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["op_id", "op", "target_id", "portable"],
      "properties": {
        "op_id": {"$ref": "#/$defs/opId"},
        "op": {"const": "set_portable"},
        "target_id": {"$ref": "#/$defs/entityId"},
        "portable": {"type": "boolean"}
      }
    },
    "setNpcQueueOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["op_id", "op", "npc_id", "actions"],
      "properties": {
        "op_id": {"$ref": "#/$defs/opId"},
        "op": {"const": "set_npc_queue"},
        "npc_id": {"type": "string", "pattern": "^npc\\.[a-z][a-z0-9_]*$", "maxLength": 96},
        "actions": {
          "type": "array", "maxItems": 128,
          "items": {"$ref": "#/$defs/action"}
        }
      }
    },
    "setGoalOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["op_id", "op", "goal_id", "enabled"],
      "properties": {
        "op_id": {"$ref": "#/$defs/opId"},
        "op": {"const": "set_goal"},
        "goal_id": {"$ref": "#/$defs/slug"},
        "enabled": {"type": "boolean"}
      }
    },
    "publicGoal": {
      "type": "object", "additionalProperties": false,
      "required": ["goal_id", "description", "success_condition_ids"],
      "properties": {
        "goal_id": {"$ref": "#/$defs/slug"},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "success_condition_ids": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"$ref": "#/$defs/slug"}
        }
      }
    },
    "condition": {
      "oneOf": [
        {"$ref": "#/$defs/entityStateCondition"},
        {"$ref": "#/$defs/entityRoomCondition"},
        {"$ref": "#/$defs/playerRoomCondition"},
        {"$ref": "#/$defs/interactionCondition"},
        {"$ref": "#/$defs/elapsedCondition"}
      ]
    },
    "conditionId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 96},
    "stateField": {"enum": ["open", "active", "powered", "portable", "visible", "occupied", "filled", "liquid_level", "hazard", "held_by", "placed_at", "status"]},
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "entityStateCondition": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_id", "type", "target_id", "field", "operator", "value"],
      "properties": {
        "condition_id": {"$ref": "#/$defs/conditionId"},
        "type": {"const": "entity_state"},
        "target_id": {"$ref": "#/$defs/entityId"},
        "field": {"$ref": "#/$defs/stateField"},
        "operator": {"enum": ["eq", "ne", "gte", "lte"]},
        "value": {"$ref": "#/$defs/scalar"}
      }
    },
    "entityRoomCondition": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_id", "type", "target_id", "room_id"],
      "properties": {
        "condition_id": {"$ref": "#/$defs/conditionId"},
        "type": {"const": "entity_room"},
        "target_id": {"$ref": "#/$defs/entityId"},
        "room_id": {"$ref": "#/$defs/roomId"}
      }
    },
    "playerRoomCondition": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_id", "type", "room_id"],
      "properties": {
        "condition_id": {"$ref": "#/$defs/conditionId"},
        "type": {"const": "player_room"},
        "room_id": {"$ref": "#/$defs/roomId"}
      }
    },
    "interactionCondition": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_id", "type", "target_id", "affordance"],
      "properties": {
        "condition_id": {"$ref": "#/$defs/conditionId"},
        "type": {"const": "interaction"},
        "target_id": {"$ref": "#/$defs/entityId"},
        "affordance": {"enum": ["open", "close", "pick_up", "drop", "place", "toggle", "sit", "inspect"]}
      }
    },
    "elapsedCondition": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_id", "type", "operator", "seconds"],
      "properties": {
        "condition_id": {"$ref": "#/$defs/conditionId"},
        "type": {"const": "elapsed"},
        "operator": {"enum": ["gte", "lte"]},
        "seconds": {"type": "number", "minimum": 0, "maximum": 86400}
      }
    },
    "resetPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "reset_npc_queues", "release_held_items"],
      "properties": {
        "mode": {"const": "restore_baseline"},
        "reset_npc_queues": {"const": true},
        "release_held_items": {"const": true}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset", "sample_id", "verification", "public_reference"],
      "properties": {
        "dataset": {"const": "VISTA"},
        "sample_id": {"$ref": "#/$defs/eventId"},
        "verification": {"const": "verified"},
        "public_reference": {"type": "string", "pattern": "^vista://assist-step/mmg_[0-9]{3}$"}
      }
    }
  }
}
